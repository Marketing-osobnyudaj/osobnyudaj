---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogArticle from '../../components/content/BlogArticle.astro';
import RelatedPosts from '../../components/content/RelatedPosts.astro';
import Newsletter from '../../components/content/Newsletter.astro';
import { posts, relatedPosts, type Post } from '../../data/blog';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout title={`${post.title} – Blog – Osobný údaj`}>
  <BlogArticle post={post} />
  <RelatedPosts posts={relatedPosts(post.cats, 3, post.slug)} />
  <Newsletter flush />
</BaseLayout>
