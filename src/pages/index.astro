---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesPicker from '../components/home/ServicesPicker.astro';
import AiAdvisor from '../components/home/AiAdvisor.astro';
import Benefits from '../components/home/Benefits.astro';
import VideoReference from '../components/home/VideoReference.astro';
import TrustLogos from '../components/sections/TrustLogos.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import RegionalContacts from '../components/sections/RegionalContacts.astro';
import ReferencesCarousel from '../components/sections/ReferencesCarousel.astro';
import ClientStats from '../components/sections/ClientStats.astro';
import Ratings from '../components/sections/Ratings.astro';
import QuoteForm from '../components/sections/QuoteForm.astro';
---

<BaseLayout title="Osobný údaj – ochrana osobných údajov a kybernetická bezpečnosť">
  <Hero />
  <TrustLogos showLink />
  <ServicesPicker />
  <AiAdvisor />
  <Benefits />
  <VideoReference />
  <CtaBanner />
  <BlogTeaser />
  <RegionalContacts />
  <ReferencesCarousel />
  <ClientStats />
