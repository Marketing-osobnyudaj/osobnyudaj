---
const chips = ['GDPR', 'Kyberbezpečnosť', 'Vzory smerníc', '...'];
---

<section class="ai container">
  <div class="ai__box" data-ai>
    <div class="eyebrow eyebrow--on-blue">/ AI online poradca /</div>
    <h2 class="ai__title">Neviete, kde začať? Náš AI poradca vás nasmeruje.</h2>
    <form class="ai__form" data-ai-form>
      <label for="ai-question" class="visually-hidden">Vaša otázka</label>
      <input id="ai-question" name="q" placeholder="Opýtajte sa hocičo..." autocomplete="off" data-ai-input />
      <button type="submit" class="btn btn--primary btn--sm">Opýtať sa</button>
    </form>
    <div class="ai__chips">
      {chips.map((c) => <button type="button" class="ai__chip" data-ai-chip={c === '...' ? '' : c}>{c}</button>)}
    </div>
    <div class="ai__answer" data-ai-answer hidden aria-live="polite"></div>
  </div>
</section>

<style>
  .ai {
    padding-top: 128px;
  }
  .ai__box {
    border-radius: var(--radius-lg);
    background: var(--grad-blue);
    padding: 72px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    color: #fff;
  }
  .ai__title {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .ai__form {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 720px;
    margin-top: 8px;
    padding: 8px 8px 8px 24px;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 14px 14px rgba(0, 0, 0, 0.14), 0 4px 8px rgba(0, 0, 0, 0.16);
  }
  .ai__form input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: 500 17px var(--font-body);
    color: var(--c-text);
  }
  .ai__form .btn {
    height: 44px;
    padding: 0 24px;
    font-size: 17px;
  }
  .ai__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .ai__chip {
    padding: 6px 14px;
    border: 0;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font: 500 14px var(--font-body);
    cursor: pointer;
  }
  .ai__chip:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .ai__answer {
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .ai__box {
      padding: 48px 20px;
    }
    .ai__title {
      font-size: 30px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ai]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-ai-form]');
    const input = root.querySelector<HTMLInputElement>('[data-ai-input]');
    const answer = root.querySelector<HTMLElement>('[data-ai-answer]');
    root.querySelectorAll<HTMLButtonElement>('[data-ai-chip]').forEach((chip) =>
      chip.addEventListener('click', () => {
        if (!input) return;
        input.value = chip.dataset.aiChip || '';
        input.focus();
      }),
    );
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input?.value.trim();
      if (!q || !answer) return;
      // TODO: connect to the AI advisor backend.
      answer.textContent = `Ďakujeme, poradca pripravuje odpoveď na: „${q}“`;
      answer.hidden = false;
    });
  });
</script>
