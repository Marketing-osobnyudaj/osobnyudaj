---
import Pager from './Pager.astro';
import { ebooks, ebookSegments, EBOOKS_PER_PAGE } from '../../data/ebooks';
---

<section class="eb container" data-ebooks data-per={EBOOKS_PER_PAGE}>
  <h1 class="eb__title">eBooky</h1>

  <div class="eb__tabs-wrap">
    <div class="eb__tabs" role="group" aria-label="Segment">
      {
        ebookSegments.map((s, i) => (
          <button type="button" class="tab" data-seg={s} aria-pressed={i === 0 ? 'true' : 'false'}>
            <svg class="tab__check" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
              <rect x="2" y="2" width="16" height="16" rx="3" fill="#fff" />
              <path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{s}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="eb__grid">
    {
      ebooks.map((e, i) => (
        <a href={e.href} class="book" data-book data-segs={e.segs.join('|')} hidden={i >= EBOOKS_PER_PAGE}>
          <div class="book__cover">
            <span class="badge badge--pdf">PDF</span>
            <span class="badge badge--kind">E-kniha</span>
          </div>
          <div class="book__tags">
            <span>{e.cat}</span>
            {e.segs.map((s) => (
              <span>{s}</span>
            ))}
          </div>
          <h2 class="book__title">{e.title}</h2>
          <p class="book__desc">{e.desc}</p>
        </a>
      ))
    }
  </div>
  <p class="eb__empty" data-empty hidden>Pre tento segment zatiaľ nemáme žiadne e-knihy.</p>

  <Pager pages={Math.ceil(ebooks.length / EBOOKS_PER_PAGE)} />
</section>

<style>
  .eb {
    padding-top: 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .eb__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--c-navy);
  }
  .eb__tabs-wrap {
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 10px;
    margin: 0 calc(-1 * var(--gutter));
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
  .eb__tabs {
    display: flex;
    gap: 6px;
    width: max-content;
  }
  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
    font: 500 15px var(--font-body);
    background: rgb(243, 244, 246);
    color: var(--c-text-2);
  }
  .tab:hover {
    background: var(--c-hover);
  }
  .tab__check {
    display: none;
    flex-shrink: 0;
    color: var(--c-accent);
  }
  .tab[aria-pressed='true'] {
    background: var(--c-accent);
    color: #fff;
  }
  .tab[aria-pressed='true'] .tab__check {
    display: block;
  }
  .tab[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background: var(--c-accent);
    transform: translateX(-50%) rotate(45deg);
  }
  .tab span,
  .tab svg {
    position: relative;
    z-index: 1;
  }
  .eb__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 56px 64px;
  }
  .book {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    color: var(--c-text-2);
  }
  .book[hidden],
  .eb__empty[hidden] {
    display: none;
  }
  .book:hover {
    color: var(--c-navy);
  }
  .book__cover {
    aspect-ratio: 330 / 250;
    border-radius: var(--radius-lg);
    background: var(--c-tint);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 6px;
    padding: 8px;
  }
  .badge {
    padding: 3px 10px;
    border-radius: 2px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .badge--pdf {
    background: rgb(219, 22, 47);
  }
  .badge--kind {
    background: var(--c-primary-light);
  }
  .book__tags {
    display: flex;
    gap: 4px 14px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--c-accent);
  }
  .book__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .book__desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
  }
  .eb__empty {
    margin: 0;
    padding: 40px 0;
    font-size: 17px;
    text-align: center;
    color: rgb(110, 118, 132);
  }
  .eb :global(.pager) {
    padding-bottom: 96px;
  }
  @media (max-width: 760px) {
    .eb {
      padding-top: 56px;
    }
    .eb__title {
      font-size: 32px;
    }
  }
</style>

<script>
  import { createPager } from './pager';

  document.querySelectorAll<HTMLElement>('[data-ebooks]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-seg]'));
    const books = Array.from(root.querySelectorAll<HTMLElement>('[data-book]'));
    const emptyMsg = root.querySelector<HTMLElement>('[data-empty]');
    const pagerEl = root.querySelector<HTMLElement>('[data-pager]');
    const pager = pagerEl ? createPager(pagerEl, books, Number(root.dataset.per) || 12) : null;

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        // The first tab ("Všeobecné") shows every e-book.
        const seg = tab.dataset.seg!;
        const shown = i === 0 ? books : books.filter((b) => (b.dataset.segs ?? '').split('|').includes(seg));
        pager?.setItems(shown);
        if (emptyMsg) emptyMsg.hidden = shown.length > 0;
      }),
    );
  });
</script>
