---
// "Populárne témy" cards + the filterable FAQ accordion with the topics/segments sidebar.
import { faqs, faqUrl } from '../../data/faq';
import { menuSegments } from '../../data/site';

const categories = [...new Set(faqs.map((f) => f.cat))];
const tabs = ['Všetky', ...categories];

// TODO: real copy (the design has lorem ipsum for the topic card descriptions).
const topicDesc = 'Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae';
const topics = ['GDPR', 'Kyberbezpečnosť', 'Kyberšikana', 'NIS 2', 'O nás', 'Whistleblowing'];

const segments = [
  ...menuSegments.map((s) => ({ title: s.title, href: s.href })),
  { title: 'Súkromný sektor', href: '#' },
].sort((a, b) => a.title.localeCompare(b.title, 'sk'));
---

<div data-faq>
  <section class="topics container" aria-labelledby="faq-topics-title">
    <h2 class="h2 h2--sm topics__title" id="faq-topics-title">Populárne témy</h2>
    <div class="topics__grid">
      {
        topics.map((t) => (
          <button type="button" class="topic" data-topic={t}>
            <span class="topic__title">{t}</span>
            <span class="topic__desc">{topicDesc}</span>
            <span class="topic__more">Zobraziť otázky →</span>
          </button>
        ))
      }
    </div>
  </section>

  <section class="qa container" id="otazky" aria-label="Otázky a odpovede">
    <div class="qa__main">
      <div class="qa__tabs" role="group" aria-label="Kategória">
        {
          tabs.map((t, i) => (
            <button type="button" class="qa__tab" data-tab={i === 0 ? '' : t} aria-pressed={i === 0 ? 'true' : 'false'}>
              {t}
            </button>
          ))
        }
      </div>
      <p class="qa__empty" data-empty hidden>Nenašli sa žiadne výsledky.</p>
      <div class="qa__list">
        {
          faqs.map((f, i) => (
            <div class="item" data-item data-cat={f.cat} data-text={`${f.q} ${f.a}`.toLowerCase()}>
              <h3 class="item__h">
                <button type="button" class="item__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
                  <span class="item__text">
                    <span class="item__cat">{f.cat}</span>
                    <span class="item__q">{f.q}</span>
                  </span>
                  <span class="item__sign" aria-hidden="true" />
                </button>
              </h3>
              <div class="item__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden={i !== 0}>
                <p>{f.a}</p>
                <a href={faqUrl(f)}>Čítať viac →</a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <aside class="side">
      <div class="side__group">
        <h2 class="side__title">Témy</h2>
        <div class="side__links">
          {
            topics.map((t) => (
              <button type="button" class="side__topic" data-topic={t}>
                {t}
              </button>
            ))
          }
        </div>
      </div>
      <div class="side__group">
        <h2 class="side__title">Segmenty</h2>
        <div class="side__segs">
          {segments.map((s) => <a href={s.href}>{s.title}</a>)}
        </div>
      </div>
    </aside>
  </section>
</div>

<style>
  .topics {
    padding-top: 32px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .topics__title {
    text-align: center;
  }
  .topics__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 30px;
  }
  .topic {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 32px;
    border: 0;
    border-radius: var(--radius-lg);
    background: #fff;
    cursor: pointer;
    text-align: left;
    box-shadow: inset 0 0 0 1.5px rgb(237, 239, 245), 0 0 2px rgba(163, 170, 181, 0.7),
      0 25px 25px rgba(119, 138, 178, 0.07), 0 6px 14px rgba(119, 138, 178, 0.08);
    transition: transform 0.15s;
  }
  .topic:hover {
    transform: translateY(-2px);
  }
  .topic__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    color: var(--c-navy);
  }
  .topic__desc {
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-text-2);
  }
  .topic__more {
    font-size: 15px;
    font-weight: 600;
    color: var(--c-accent);
  }

  .qa {
    padding-bottom: 128px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 48px 64px;
    align-items: start;
    scroll-margin-top: 24px;
  }
  .qa__main {
    grid-column: span 2;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .qa__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .qa__tab {
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    font: 500 15px var(--font-body);
    background: rgb(243, 244, 246);
    color: var(--c-text-2);
  }
  .qa__tab[aria-pressed='true'] {
    background: var(--c-accent);
    color: #fff;
  }
  .qa__empty {
    margin: 0;
    padding: 32px 0;
    font-size: 17px;
    color: var(--c-text-2);
  }
  .qa__empty[hidden],
  .item[hidden],
  .item__a[hidden] {
    display: none;
  }
  .qa__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(214, 224, 242);
  }
  .item {
    border-bottom: 1px solid rgb(214, 224, 242);
  }
  .item__h {
    margin: 0;
  }
  .item__btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .item__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .item__cat {
    font: 500 13px var(--font-body);
    color: var(--c-accent);
  }
  .item__q {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: rgb(37, 40, 71);
  }
  .item__btn:hover .item__q {
    color: var(--c-navy);
  }
  .item__sign {
    flex-shrink: 0;
    font: 400 26px var(--font-body);
    color: var(--c-primary);
  }
  .item__sign::before {
    content: '+';
  }
  .item__btn[aria-expanded='true'] .item__sign::before {
    content: '−';
  }
  .item__a {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 24px;
  }
  .item__a p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-text-2);
  }
  .item__a a {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 600;
    color: var(--c-accent);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--c-tint);
  }
  .side__group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .side__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    color: var(--c-text-2);
  }
  .side__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .side__topic {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: 500 16px var(--font-body);
    color: var(--c-accent);
    text-align: left;
  }
  .side__topic:hover {
    color: var(--c-accent-hover);
  }
  .side__segs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .side__segs a {
    padding: 4px 8px;
    border-radius: 2px;
    background: #fff;
    font-size: 13px;
    font-weight: 500;
    color: var(--c-text-2);
  }
  .side__segs a:hover {
    color: var(--c-accent);
  }
  @media (max-width: 680px) {
    .qa__main {
      grid-column: auto;
    }
    .item__q {
      font-size: 18px;
    }
    .side {
      padding: 24px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const input = document.querySelector<HTMLInputElement>('[data-search-input="faq"]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-item]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const emptyMsg = root.querySelector<HTMLElement>('[data-empty]');
    const list = root.querySelector<HTMLElement>('#otazky');
    let tab = '';

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.querySelector('.item__btn')?.setAttribute('aria-expanded', String(open));
      const a = item.querySelector<HTMLElement>('.item__a');
      if (a) a.hidden = !open;
    };

    const update = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let n = 0;
      items.forEach((item) => {
        const text = item.dataset.text ?? '';
        const show = (!tab || item.dataset.cat === tab) && (!q || text.includes(q));
        item.hidden = !show;
        if (show) n++;
      });
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === tab)));
      if (emptyMsg) emptyMsg.hidden = n > 0;
    };

    items.forEach((item) =>
      item.querySelector('.item__btn')?.addEventListener('click', () => {
        const open = item.querySelector('.item__btn')?.getAttribute('aria-expanded') !== 'true';
        items.forEach((other) => setOpen(other, other === item && open));
      }),
    );
    tabs.forEach((b) =>
      b.addEventListener('click', () => {
        tab = b.dataset.tab ?? '';
        update();
      }),
    );
    // Topic cards and sidebar topics: switch to the matching category tab (or "Všetky") and jump to the list.
    root.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) =>
      b.addEventListener('click', () => {
        const t = b.dataset.topic ?? '';
        tab = tabs.some((x) => x.dataset.tab === t) ? t : '';
        update();
        list?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }),
    );
    input?.addEventListener('input', update);
    update();
  });
</script>
