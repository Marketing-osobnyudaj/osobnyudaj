---
// Markup for `createPager()` (see pager.ts). Rendered hidden when everything fits on one page.
interface Props {
  pages: number;
}
const { pages } = Astro.props;
---

<div class="pager" data-pager hidden={pages <= 1}>
  <button type="button" class="btn btn--primary btn--md pager__more" data-pager-more>Zobraziť ďalšie</button>
  <nav class="pager__pages" aria-label="Stránkovanie" data-pager-pages>
    {Array.from({ length: pages }, (_, i) => <button type="button" aria-current={i === 0 ? 'page' : undefined}>{i + 1}</button>)}
  </nav>
</div>

<style>
  .pager {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-top: 16px;
  }
  .pager[hidden],
  .pager__more[hidden] {
    display: none;
  }
  .pager__more {
    padding: 0 24px;
  }
  .pager__pages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
  }
  .pager__pages :global(button) {
    min-width: 28px;
    height: 32px;
    border: 0;
    background: none;
    cursor: pointer;
    font: 600 15px var(--font-body);
    color: var(--c-text-2);
  }
  .pager__pages :global(button:hover),
  .pager__pages :global(button[aria-current='page']) {
    color: var(--c-accent);
  }
</style>
