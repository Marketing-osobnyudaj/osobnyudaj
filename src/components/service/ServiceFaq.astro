---
import { faqsForPage, faqUrl } from '../../data/faq';

interface Props {
  /** Page name used by the FAQ category rules. */
  page: string;
}
const { page } = Astro.props;
const faqs = faqsForPage(page);
const uid = 'svc-faq';
---

<section class="faq container" data-faq>
  <h2 class="h2 faq__title">Často kladené otázky</h2>
  <div class="faq__list">
    {
      faqs.map((f, i) => (
        <div class="faq__item">
          <h3 class="faq__q">
            <button
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`${uid}-${i}`}
              id={`${uid}-${i}-btn`}
              data-faq-toggle
            >
              {f.q}
              <span class="faq__sign" aria-hidden="true" />
            </button>
          </h3>
          <div class="faq__a" id={`${uid}-${i}`} role="region" aria-labelledby={`${uid}-${i}-btn`} hidden={i !== 0}>
            <p>{f.a}</p>
            <a href={faqUrl(f)} class="faq__more">Čítať viac →</a>
          </div>
        </div>
      ))
    }
    {faqs.length === 0 && <p class="faq__empty">V tejto kategórii zatiaľ nie sú žiadne otázky.</p>}
  </div>
</section>

<style>
  .faq {
    max-width: 960px;
    padding-bottom: 128px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .faq__title {
    text-align: center;
  }
  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(214, 224, 242);
  }
  .faq__item {
    border-bottom: 1px solid rgb(214, 224, 242);
  }
  .faq__q {
    margin: 0;
  }
  .faq__q button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
    color: rgb(37, 40, 71);
  }
  .faq__q button:hover {
    color: var(--c-navy);
  }
  .faq__sign {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 400;
    color: var(--c-primary);
  }
  .faq__sign::before {
    content: '+';
  }
  [aria-expanded='true'] .faq__sign::before {
    content: '−';
  }
  .faq__a {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 24px;
    max-width: 820px;
  }
  .faq__a[hidden] {
    display: none;
  }
  .faq__a p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-text-2);
  }
  .faq__more {
    font-size: 15px;
    font-weight: 600;
    color: var(--c-accent);
  }
  .faq__empty {
    margin: 0;
    padding: 24px 0;
    font-size: 16px;
    color: rgb(110, 118, 132);
    text-align: center;
  }
</style>

<script>
  // FAQ accordion: one answer open at a time.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]'));
    const panel = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls') ?? '');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        buttons.forEach((b) => {
          const on = b === btn && open;
          b.setAttribute('aria-expanded', String(on));
          const p = panel(b);
          if (p) p.hidden = !on;
        });
      }),
    );
  });
</script>
