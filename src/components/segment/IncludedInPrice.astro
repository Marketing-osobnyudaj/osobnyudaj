---
// "Čo všetko dostanete v cene" — light-blue panel with a two-column checklist and a CTA.
interface Props {
  id?: string;
  items: { title: string; text: string }[];
}
const { id, items } = Astro.props;
const half = Math.ceil(items.length / 2);
const columns = [items.slice(0, half), items.slice(half)];
---

<section class="incl" id={id}>
  <div class="incl__panel">
    <div class="incl__head">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M32 6 58 19 32 32 6 19Z"></path><path d="M6 32l26 13 26-13"></path><path d="M6 45l26 13 26-13"></path></svg>
      <h2 class="incl__title">Čo všetko dostanete v cene</h2>
    </div>
    <div class="incl__grid">
      {
        columns.map((col) => (
          <ul class="incl__col">
            {col.map((f) => (
              <li class="incl__item">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="4" fill="currentColor"></circle></svg>
                <div>
                  <strong>{f.title}</strong>
                  <br />
                  {f.text}
                </div>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    <div class="incl__cta">
      <div class="incl__cta-title">Mám záujem o bezplatnú cenovú ponuku</div>
      <a href="#cenova-ponuka" class="btn btn--primary incl__btn">Bezplatná cenová ponuka</a>
    </div>
  </div>
</section>

<style>
  .incl {
    max-width: 1242px;
    margin: 0 auto;
    padding: 32px var(--gutter) 0;
    box-sizing: content-box;
    scroll-margin-top: 24px;
  }
  .incl__panel {
    border-radius: var(--radius-lg);
    background: rgb(235, 243, 255);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    padding: 64px clamp(20px, 8vw, 120px) 80px;
  }
  .incl__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--c-primary-light);
  }
  .incl__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    text-align: center;
    color: var(--c-text-2);
  }
  .incl__grid {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    column-gap: 90px;
    row-gap: 24px;
  }
  .incl__col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .incl__item {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    min-height: 48px;
    font-size: 17px;
    line-height: 1.4;
    color: var(--c-text-2);
  }
  .incl__item svg {
    flex-shrink: 0;
    color: var(--c-primary);
  }
  .incl__item strong {
    font-weight: 700;
  }
  .incl__cta {
    max-width: 651px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 32px 0;
  }
  .incl__cta-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-align: center;
    color: var(--c-navy);
  }
  .incl__btn {
    height: 54px;
    padding: 0 40px;
  }
  @media (max-width: 760px) {
    .incl__panel {
      gap: 40px;
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .incl__cta {
      padding: 0;
    }
    .incl__cta-title {
      font-size: 24px;
    }
  }
</style>
