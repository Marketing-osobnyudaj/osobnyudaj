---
// Horizontal carousel of service cards ("Naše služby pre …" on segment pages, "Súvisiace služby" on GDPR pre školy).
import type { ServiceCard } from '../../data/segment-pages';

interface Props {
  eyebrow: string;
  title: string;
  /** Second line of each card title, e.g. "pre vašu obec". */
  suffix: string;
  items: ServiceCard[];
  /** 'segment' = with descriptions and the blue line on top; 'related' = compact cards, accent price. */
  variant?: 'segment' | 'related';
}
const { eyebrow, title, suffix, items, variant = 'segment' } = Astro.props;
---

<section class:list={['svc', `svc--${variant}`]} data-svc-carousel>
  <div class="svc__bg" aria-hidden="true"></div>
  {variant === 'segment' && <div class="svc__line" aria-hidden="true" />}
  <div class="svc__inner container">
    <div class="section-head section-head--center svc__head">
      <div class="eyebrow svc__eyebrow">{eyebrow}</div>
      <h2 class="h2 h2--sm">{title}</h2>
    </div>
    <div class="svc__body">
      <div class="svc__viewport">
        <ul class="svc__track" data-track>
          {
            items.map((c) => (
              <li class="svc__item">
                <a href={c.href} class="svc-card">
                  <img src={c.icon} alt="" width="120" height="120" class="svc-card__icon" loading="lazy" />
                  <div class="svc-card__body">
                    <h3 class="svc-card__title">
                      {c.title}
                      <br />
                      {suffix}
                    </h3>
                    {c.desc ? <p class="svc-card__desc">{c.desc}</p> : <div class="svc-card__spacer" />}
                    <div class="svc-card__price">{c.price}</div>
                    <div class="svc-card__arrow" aria-hidden="true">→</div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="svc__nav">
        <button type="button" class="svc__btn" aria-label="Predchádzajúce" data-prev>
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16.7" fill="currentColor"></circle><path d="M22.5 13.5 16 20l6.5 6.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button type="button" class="svc__btn" aria-label="Ďalšie" data-next>
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16.7" fill="currentColor"></circle><path d="M17.5 13.5 24 20l-6.5 6.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    padding: 155px 0 96px;
    overflow: hidden;
  }
  .svc__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 735px;
    background: linear-gradient(180deg, rgb(232, 240, 252) 0%, rgb(234, 241, 252) 25%, rgba(244, 247, 253, 0.8) 70%, rgba(255, 255, 255, 0) 100%);
    clip-path: polygon(0 92px, 100% 12px, 100% 100%, 0 100%);
    pointer-events: none;
  }
  .svc--related .svc__bg {
    height: 640px;
    clip-path: polygon(0 86px, 100% 6px, 100% 100%, 0 100%);
  }
  .svc__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100px;
    background: linear-gradient(90deg, var(--c-navy) 0%, var(--c-primary) 100%);
    clip-path: polygon(0 89px, 100% 9px, 100% 15px, 0 95px);
    pointer-events: none;
  }
  .svc__inner {
    position: relative;
    max-width: 1282px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
  }
  .svc__head {
    gap: 12px;
    max-width: 640px;
  }
  .svc__eyebrow {
    mix-blend-mode: multiply;
  }
  .svc__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }
  .svc__viewport {
    width: 100%;
    overflow: hidden;
    padding: 12px 0 40px;
    margin: -12px 0 -40px;
  }
  .svc__track {
    --per: 4;
    --gap: 30px;
    --i: 0;
    --w: calc((100% - var(--gap) * (var(--per) - 1)) / var(--per));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    transition: transform 0.45s ease;
    transform: translateX(calc(var(--i) * -1 * (var(--w) + var(--gap))));
  }
  .svc__item {
    flex: 0 0 var(--w);
    display: flex;
    flex-direction: column;
  }
  .svc-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--c-text-2);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s;
  }
  .svc-card:hover {
    transform: translateY(-3px);
    color: var(--c-text-2);
  }
  .svc-card__icon {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }
  .svc-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-self: stretch;
    flex: 1;
  }
  .svc-card__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }
  .svc-card__desc {
    margin: 0;
    flex: 1;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
  }
  .svc-card__spacer {
    flex: 1;
  }
  .svc-card__price {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
  }
  .svc--related .svc-card__price {
    color: var(--c-accent);
  }
  .svc-card__arrow {
    color: var(--c-accent);
    font-size: 20px;
    line-height: 1;
    text-align: center;
  }
  .svc__nav {
    display: flex;
    gap: 8px;
    justify-content: center;
  }
  .svc__btn {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--c-accent);
  }
  .svc__btn:disabled {
    cursor: default;
    color: rgb(224, 225, 227);
  }

  @media (max-width: 1199px) {
    .svc__track {
      --per: 3;
    }
  }
  @media (max-width: 899px) {
    .svc__track {
      --per: 2;
    }
  }
  @media (max-width: 639px) {
    .svc {
      padding-top: 130px;
    }
    .svc__track {
      --per: 1;
    }
    .svc__inner {
      gap: 40px;
    }
  }
</style>

<script>
  // Service cards carousel: prev/next by one card, buttons disabled at the ends.
  document.querySelectorAll<HTMLElement>('[data-svc-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !prev || !next) return;
    const total = track.children.length;
    let i = 0;
    const max = () => Math.max(0, total - (Number(getComputedStyle(track).getPropertyValue('--per')) || 4));
    const render = () => {
      i = Math.max(0, Math.min(i, max()));
      track.style.setProperty('--i', String(i));
      prev.disabled = i <= 0;
      next.disabled = i >= max();
      Array.from(track.children).forEach((li, k) => {
        const visible = k >= i && k < i + total - max();
        li.querySelector('a')?.setAttribute('tabindex', visible ? '0' : '-1');
      });
    };
    prev.addEventListener('click', () => {
      i -= 1;
      render();
    });
    next.addEventListener('click', () => {
      i += 1;
      render();
    });
    window.addEventListener('resize', render);
    render();
  });
</script>
