---
import { contact, routes, footerColumns } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__edge" aria-hidden="true"></div>
  <div class="footer__stripe" aria-hidden="true"></div>
  <div class="footer__inner container">
    <a href={routes.home} class="footer__brand" aria-label="Osobný údaj – domov">
      <svg width="40" height="26" viewBox="0 0 40 26" fill="#fff" aria-hidden="true">
        <path d="M9 0h5L5 26H0z"></path><path d="M21 0h5l-9 26h-5z"></path><path d="M33 0h5l-9 26h-5z"></path>
      </svg>
      OSOBNÝ ÚDAJ
    </a>

    <div class="footer__main">
      <div class="footer__contacts">
        <a href={contact.phoneHref}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
          {contact.phone}
        </a>
        <a href={`mailto:${contact.email}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M2 11 22 3l-3.5 18-6-4.5-3 3v-5l9-8.5-11 7z"></path></svg>
          {contact.email}
        </a>
      </div>

      <div class="footer__cols">
        {
          footerColumns.map((col) => (
            <div class="footer__col">
              <div class="footer__group">
                <div class="footer__title">{col.title}</div>
                {col.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </div>
              {col.cookies && (
                <a href="#" class="footer__cookies">
                  Nastavenie súborov cookies
                </a>
              )}
            </div>
          ))
        }
      </div>

      <div class="footer__social">
        <a href="https://www.facebook.com/osobnyudajsk" aria-label="Facebook">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"></path></svg>
        </a>
        <a href="https://www.linkedin.com/company/14816191" aria-label="LinkedIn">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M22 0H2a2 2 0 0 0-2 2v20a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM7.1 20.5H3.6V9h3.5zM5.3 7.4a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1zm15.2 13.1H17v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5z"></path></svg>
        </a>
      </div>

      <div class="footer__legal">
        <span>{year} © osobnyudaj.sk <a href="#" class="footer__strong">Obchodné podmienky</a></span>
        <span class="footer__strong">
          <a href="#">Ochrana osobných údajov</a>
          <a href="#">Projekt spolufinancovaný zo zdrojov EÚ</a>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: -80px;
    background: linear-gradient(90deg, rgb(62, 88, 183) 0%, rgb(92, 135, 222) 100%);
    color: #fff;
  }
  .footer a {
    color: var(--c-pale);
  }
  .footer a:hover {
    color: #fff;
  }
  .footer__edge {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 80px;
    background: rgb(237, 243, 252);
    clip-path: polygon(0 0, 100% 0, 100% 0, 0 100%);
  }
  .footer__stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 80px;
    background: var(--c-accent);
    clip-path: polygon(0 92%, 100% 0, 100% 8%, 0 100%);
  }
  .footer__inner {
    position: relative;
    padding-top: 130px;
    padding-bottom: 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 96px;
  }
  .footer .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    width: 236px;
    flex-shrink: 0;
    color: #fff;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .footer__main {
    flex: 1;
    min-width: min(100%, 300px);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .footer__contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .footer .footer__contacts a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 72px;
    border-bottom: 1px solid #fff;
    color: #fff;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 21px;
  }
  .footer .footer__contacts a:hover {
    color: var(--c-pale);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 40px 41px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .footer__group {
    display: flex;
    flex-direction: column;
  }
  .footer__group a {
    font-size: 15px;
    line-height: 28px;
  }
  .footer__title {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 14px;
  }
  .footer .footer__cookies {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.4;
    color: #fff;
  }
  .footer__social {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: -24px;
  }
  .footer__social a {
    display: block;
    line-height: 0;
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    margin-top: -24px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--c-pale);
  }
  .footer__strong,
  .footer__strong a {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 16px;
  }
</style>
