---
interface Props {
  title?: string;
  buttonLabel?: string;
  href?: string;
}
const {
  title = 'Mám záujem o bezplatnú cenovú ponuku',
  buttonLabel = 'Bezplatná cenová ponuka',
  href = '#cenova-ponuka',
} = Astro.props;
---

<section class="cta container">
  <h2 class="h2">{title}</h2>
  <a href={href} class="btn btn--primary">{buttonLabel}</a>
</section>

<style>
  .cta {
    padding-top: 128px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }
  .cta .h2 {
    max-width: 560px;
  }
</style>
