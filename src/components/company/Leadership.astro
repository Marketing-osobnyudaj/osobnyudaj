---
import { leaders } from '../../data/company';
import { routes } from '../../data/site';
---

<section class="lead-team">
  <h2 class="h2 h2--sm">Vedenie spoločnosti</h2>
  <ul class="lead-team__list">
    {
      leaders.map((p) => (
        <li class="leader">
          <img src={p.photo} alt={p.name} width="288" height="288" loading="lazy" />
          <div class="leader__name">{p.name}</div>
          <div class="leader__role">{p.role}</div>
        </li>
      ))
    }
  </ul>
  <a href={routes.nasTim} class="btn btn--primary">Spoznajte ďalších 40 kolegov</a>
</section>

<style>
  .lead-team {
    max-width: 1240px;
    margin: 0 auto;
    padding: 128px 20px 0;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    text-align: center;
  }
  .lead-team__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 48px 30px;
    width: 100%;
  }
  .leader {
    width: 288px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--c-text-2);
  }
  .leader img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    object-fit: cover;
    background: var(--c-pale);
    margin-bottom: 16px;
  }
  .leader__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .leader__role {
    font-size: 16px;
    line-height: 1.4;
  }
  @media (max-width: 760px) {
    .lead-team {
      padding-top: 96px;
      gap: 40px;
    }
    .leader {
      width: calc(50% - 15px);
    }
  }
  @media (max-width: 420px) {
    .leader {
      width: 100%;
    }
  }
</style>
