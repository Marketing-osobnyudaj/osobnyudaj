---
import { routes, contact } from '../../data/site';
---

<section class="career">
  <div class="section-head section-head--center">
    <div class="eyebrow">/ Kariéra /</div>
    <h2 class="h2 h2--sm career__title">Staňte sa súčasťou skúseného a dynamického tímu</h2>
  </div>
  <div class="career__grid">
    <div class="career__text">
      <p>
        Zaujíma vás práca v oblasti ochrany osobných údajov a kybernetickej bezpečnosti? Hľadáme zodpovedných profesionálov,
        ktorí nám pomôžu budovať bezpečné digitálne prostredie.
      </p>
      <p>
        Pošlite nám svoj životopis na <a href={`mailto:${contact.email}`}>{contact.email}</a> a ozveme sa vám.
      </p>
      <a href={routes.kariera} class="btn btn--primary btn--md">Kariéra v Osobnyudaj.sk</a>
    </div>
    {/* The design has a "Foto tímu" placeholder here; the O nás banner photo is used instead. */}
    <img
      class="career__photo"
      src="/assets/onas-banner.webp"
      alt="Tím Osobnyudaj.sk"
      width="6048"
      height="3840"
      loading="lazy"
    />
  </div>
</section>

<style>
  .career {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .career .section-head {
    gap: 12px;
  }
  .career__title {
    max-width: 606px;
  }
  .career__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 30px;
    align-items: center;
  }
  .career__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-right: 30px;
    font-size: 17px;
    line-height: 1.4;
    color: var(--c-text-2);
  }
  .career__text p {
    margin: 0;
  }
  .career__text p a {
    color: var(--c-accent);
    font-weight: 600;
  }
  .career__photo {
    display: block;
    width: 100%;
    height: 454px;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  @media (max-width: 760px) {
    .career {
      gap: 40px;
    }
    .career__text {
      padding-right: 0;
    }
    .career__photo {
      height: 260px;
    }
  }
</style>
