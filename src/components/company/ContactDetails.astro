---
import { contact } from '../../data/site';

const icon = (d: string, color = 'var(--c-primary-light)') =>
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  people:
    '<circle cx="9" cy="8" r="3.2"></circle><circle cx="17" cy="9" r="2.4"></circle><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"></path><path d="M15.5 14c2.9 0 5.5 1.9 5.5 5"></path>',
  badge:
    '<rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="12" cy="10" r="3"></circle><path d="M7 21c.6-2.9 2.6-4.5 5-4.5s4.4 1.6 5 4.5"></path>',
  doc: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h6"></path>',
  pin: '<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>',
};
const phoneSvg =
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>';
const sendSvg =
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"></path><path d="M22 2 15 22l-4-9-9-4z"></path></svg>';
---

<section class="details">
  <div class="block">
    <Fragment set:html={icon(icons.people)} />
    <h2>Zákaznícka podpora</h2>
    <p>Špecializovaný tím zákazníckej podpory pre registrovaných zákazníkov.</p>
    <div class="block__links">
      <a href={contact.phoneHref} class="mail mail--dark"><Fragment set:html={phoneSvg} />{contact.phone}</a>
      <a href="mailto:poradna@osobnyudaj.sk" class="mail"><Fragment set:html={sendSvg} />poradna@osobnyudaj.sk</a>
    </div>
    <p class="gap">
      Pracovné dni od <strong>8:00 do 16:00 hod.</strong><br />Na e-mail odpovedáme najneskôr nasledujúci pracovný deň
    </p>
  </div>

  <div class="block">
    <Fragment set:html={icon(icons.badge)} />
    <h2>Špecializované oddelenia</h2>
    <p><strong>Zodpovedná osoba</strong></p>
    <a href="mailto:dohlad@osobnyudaj.sk" class="mail"><Fragment set:html={sendSvg} />dohlad@osobnyudaj.sk</a>
    <p class="gap"><strong>Právne oddelenie</strong></p>
    <a href="mailto:pravne@osobnyudaj.sk" class="mail"><Fragment set:html={sendSvg} />pravne@osobnyudaj.sk</a>
    <p class="gap">Na e-mail odpovedáme najneskôr <strong>nasledujúci pracovný deň</strong></p>
  </div>

  <div class="block">
    <Fragment set:html={icon(icons.doc)} />
    <h2>Fakturačné údaje</h2>
    <div class="billing">
      <div><strong>osobnyudaj.sk, s.r.o.</strong><br />Mlynské Nivy 5<br />821 09 Bratislava</div>
      <div>IČO: <strong>50 528 041</strong><br />DIČ: <strong>2120357041</strong><br />IČ DPH: <strong>SK7120001878</strong></div>
      <div class="small">
        Zápis v ORSR Obchodný register Mestského súdu Bratislava III, oddiel: Sro, vložka č. 183049/B
      </div>
      <div class="small">Banka: Fio banka, a.s.<br />IBAN: SK93 8330 0000 0026 0250 3472</div>
    </div>
  </div>

  <div class="block">
    <Fragment set:html={icon(icons.pin)} />
    <h2>Korešpondenčná adresa</h2>
    <p>Pre zasielanie zmlúv, objednávok, žiadostí, reklamácií, zariadení a pod.</p>
    <address>
      <strong>osobnyudaj.sk, s.r.o.</strong><br />Námestie osloboditeľov 3/A<br />040 01 Košice – Staré Mesto
    </address>
  </div>
</section>

<style>
  .details {
    max-width: 1240px;
    margin: 0 auto;
    padding: 128px 20px 160px;
    box-sizing: content-box;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 96px 30px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--c-text-2);
  }
  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .block h2 {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--c-navy);
  }
  .block p,
  .block address {
    margin: 0;
    font-style: normal;
  }
  .block .gap {
    margin-top: 8px;
  }
  .block__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 600;
    color: var(--c-accent);
    overflow-wrap: anywhere;
  }
  .mail--dark {
    color: var(--c-text-2);
  }
  .mail :global(svg) {
    flex-shrink: 0;
  }
  .billing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 30px;
  }
  .small {
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .details {
      padding: 96px 20px 112px;
      gap: 64px;
    }
    .block h2 {
      font-size: 24px;
    }
  }
  @media (max-width: 420px) {
    .billing {
      grid-template-columns: 1fr;
    }
  }
</style>
