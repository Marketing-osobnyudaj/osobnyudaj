---
// Rating + ZMOS partner badges (O nás hero, Kontakt hero).
interface Props {
  size?: 'lg' | 'sm';
  align?: 'center' | 'start';
}
const { size = 'lg', align = 'center' } = Astro.props;
---

<div class:list={['proofs', `proofs--${size}`, `proofs--${align}`]}>
  <div class="proof">
    <div class="proof__avatars">
      <img src="/img/avatar-1.jpg" alt="" width="48" height="48" />
      <img src="/img/avatar-2.jpg" alt="" width="48" height="48" />
      <img src="/img/avatar-3.jpg" alt="" width="48" height="48" />
    </div>
    <div class="proof__title proof__title--accent">
      4,9 / 5 <span class="stars" role="img" aria-label="5 z 5 hviezdičiek">★★★★★</span>
    </div>
    <div class="proof__text">Priemerné hodnotenie viac ako 1700 overených klientov</div>
  </div>
  <div class="proof">
    <img src="/img/zmos.png" alt="ZMOS" width="48" height="48" class="proof__logo" />
    <div class="proof__title">ZMOS</div>
    <div class="proof__text">Sme hlavným partnerom Združenia miest a obcí</div>
    <div class="proof__dots" aria-hidden="true"><span class="is-active"></span><span></span><span></span><span></span></div>
  </div>
</div>

<style>
  .proofs {
    --av: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 72px;
    text-align: left;
    color: var(--c-text-2);
  }
  .proofs--center {
    justify-content: center;
  }
  .proofs--sm {
    --av: 40px;
    gap: 24px 48px;
  }
  .proof {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proofs--sm .proof {
    gap: 6px;
    max-width: 170px;
  }
  .proof__avatars {
    display: flex;
  }
  .proof__avatars img,
  .proof__logo {
    width: var(--av);
    height: var(--av);
    border-radius: 50%;
    object-fit: cover;
  }
  .proof__avatars img {
    box-shadow: 0 0 0 3px #fff;
  }
  .proof__avatars img + img {
    margin-left: calc(var(--av) * -0.25);
  }
  .proof__title {
    display: flex;
    gap: 8px;
    align-items: center;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
  }
  .proof__title--accent {
    color: var(--c-accent);
  }
  .proof__title .stars {
    font-size: 17px;
  }
  .proofs--sm .proof__title {
    font-size: 15px;
  }
  .proofs--sm .proof__title .stars {
    font-size: 15px;
    letter-spacing: 1px;
  }
  .proof__text {
    max-width: 230px;
    font-size: 15px;
    line-height: 1.4;
  }
  .proofs--sm .proof__text {
    font-size: 13px;
    line-height: 1.3;
  }
  .proof__dots {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }
  .proof__dots span {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: rgb(245, 190, 186);
  }
  .proof__dots span.is-active {
    width: 24px;
    background: var(--c-accent);
  }
</style>
